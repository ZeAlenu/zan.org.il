---
import Base from "./Base.astro";
import Bar from "../components/Bar.astro";
import { stops, type StopId } from "../data/site";

interface Props {
  title: string;
  description?: string;
  current: StopId;
}

const { title, description, current } = Astro.props;
---

<Base title={title} description={description}>
  <Bar>
    <slot name="bar" />
  </Bar>
  <nav class="rail" aria-label="ניווט">
    {
      stops.map((stop) => (
        <a href={stop.href} aria-current={stop.id === current ? "page" : undefined}>
          {stop.label}
        </a>
      ))
    }
  </nav>
  <div id="content">
    <slot />
  </div>
</Base>
