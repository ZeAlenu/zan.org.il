---
import Base from "./Base.astro";
import Bar from "../components/Bar.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  current?: string;
  cta?: boolean;
}

const { title, description, current, cta = true } = Astro.props;
---

<Base title={title} description={description}>
  <Bar current={current} />
  <slot />
  {cta ? <CtaBand /> : null}
  <Footer />
  <script>
    import "../scripts/nav.ts";
  </script>
</Base>
