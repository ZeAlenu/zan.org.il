---
const items = [
  { href: "/about", label: "מי אנחנו" },
  { href: "/vision", label: "החזון" },
  { href: "/missions", label: "משימות" },
  { href: "/coalition", label: "הקואליציה" },
  { href: "/contact", label: "קשר" },
  { href: "/join", label: "הצטרפות", join: true },
] as const;

interface Props {
  current?: string;
}

const { current } = Astro.props;
const path = current ?? (Astro.url.pathname.replace(/\/+$/, "") || "/");
---

<header class="bar">
  <div class="bar-in">
    <a class="logo" href="/" aria-label="זה עלינו, דף הבית"><img src="/img/logo.png" alt="" /></a>
    <button class="burger" id="burger" aria-expanded="false" aria-controls="nav"><i aria-hidden="true"></i>תפריט</button>
    <nav class="nav" id="nav" aria-label="ראשי" data-open="false">
      <ul>
        {
          items.map((item) => (
            <li class={"join" in item && item.join ? "nav-join" : undefined}>
              <a href={item.href} aria-current={item.href === path ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
