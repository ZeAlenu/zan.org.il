---
import { normalizePath, utilityLinks } from "../data/catalog";
import { loadSite } from "../data/load";
import { site } from "../data/site";
import MobileNav from "./MobileNav.astro";
import SiteNav from "./SiteNav.astro";

interface Props {
  mark?: boolean;
}

const { mark = false } = Astro.props;
const pathname = normalizePath(Astro.url.pathname);
const menu = mark ? null : (await loadSite()).menu;
---

<header class:list={["bar", { "bar-mark": mark }]} data-inert-with-menu>
  <a class="logo-card" href="/" aria-label={site.name}>
    <img src="/brand/logo-star.svg" alt="" />
  </a>
  {
    menu && (
      <>
        <SiteNav groups={menu} utility={utilityLinks()} pathname={pathname} />
        <button type="button" class="menu-button" data-menu-button aria-expanded="false" aria-controls="mnav">
          תפריט
        </button>
      </>
    )
  }
</header>
{menu && <MobileNav groups={menu} utility={utilityLinks()} pathname={pathname} />}

<script>
  import { setupNav } from "./nav";

  setupNav();
</script>
