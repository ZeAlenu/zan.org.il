---
import { wingPath, type Wing } from "../data/catalog";

interface Props {
  owners: Wing[];
}

const { owners } = Astro.props;
---

<p class="byline">
  {
    owners.map((owner) => (
      <span class:list={["byline-owner", `wing-${owner.id}`]}>
        <span class="accent-rule" aria-hidden="true"></span>
        <a href={wingPath(owner)}>{owner.name}</a>
      </span>
    ))
  }
</p>
