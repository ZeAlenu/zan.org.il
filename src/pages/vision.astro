---
import Site from "../layouts/Site.astro";
import { pages, site } from "../data/site";
---

<Site title={pages.vision.title} description={pages.vision.description} current="/vision">
  <main id="main">
    <section class="page-head">
      <span class="kicker">החזון</span>
      <h1 class="display">{site.line}<em aria-hidden="true">.</em></h1>
    </section>
    <section class="sect">
      <h2 class="h2">החזון</h2>
      <div class="prose">
        <p>{site.sentence}</p>
      </div>
    </section>
  </main>
</Site>
