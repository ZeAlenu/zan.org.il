---
import Base from "../layouts/Base.astro";
import Bar from "../components/Bar.astro";
import { pages, site } from "../data/site";
---

<Base title={pages.vision.title}>
  <Bar mark />
  <main class="experience" id="content">
    <div>
      <h1>{site.line}</h1>
      <p>{site.sentence}</p>
      <nav aria-label="יציאה מן העמוד">
        <a class="action" href="/join">{site.joinTitle}</a>
      </nav>
    </div>
  </main>
</Base>
