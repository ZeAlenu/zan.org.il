---
import Frame from "../layouts/Frame.astro";
import { pages, site } from "../data/site";
---

<Frame title={pages.join.title} current="join">
  <main class="reading reading-join">
    <h1>{site.joinTitle}</h1>
    <p>{site.joinLine}</p>
    <a class="action" href={site.whatsapp} rel="noopener">{site.joinCall}</a>
  </main>
</Frame>
