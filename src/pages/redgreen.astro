---
import Base from "../layouts/Base.astro";
import Bar from "../components/Bar.astro";
import "@xyflow/react/dist/style.css";
import "../map/styles.css";
import MapApp from "../map/App.tsx";
import { pages, site } from "../data/site";
---

<Base title={pages.map.title}>
  <div class="map-screen">
    <Bar>
      <div class="bar-copy">
        <p>{site.mapKicker}</p>
        <p>{site.mapLine}</p>
      </div>
    </Bar>
    <div class="map-page" id="content">
      <h1 class="map-title">{site.mapTitle}</h1>
      <div class="map-root">
        <MapApp client:only="react" />
      </div>
    </div>
  </div>
</Base>
