---
import Base from "../layouts/Base.astro";
import "@xyflow/react/dist/style.css";
import "../map/styles.css";
import MapApp from "../map/App.tsx";
import { pages, site } from "../data/site";
---

<Base title={pages.map.title}>
  <div class="map-screen" id="main">
    <header class="map-bar">
      <a class="logo-card" href="/" aria-label={site.name}>
        <img src="/brand/logo-star.svg" alt="" />
      </a>
      <div class="bar-copy">
        <p>{site.mapKicker}</p>
        <p>{site.mapLine}</p>
      </div>
    </header>
    <div class="map-page" id="content">
      <h1 class="map-title">{site.mapTitle}</h1>
      <div class="map-root">
        <MapApp client:only="react" />
      </div>
    </div>
  </div>
</Base>
