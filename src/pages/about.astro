---
import Frame from "../layouts/Frame.astro";
import { pages, site } from "../data/site";
---

<Frame title={pages.about.title} current="about">
  <main class="reading reading-about">
    <h1>{site.name}</h1>
    <p>{site.sentence}</p>
    <p>{site.line}</p>
    <a class="action" href="/join">{site.joinTitle}</a>
  </main>
</Frame>
