---
import Site from "../layouts/Site.astro";
import { pages, site } from "../data/site";
---

<Site title={pages.about.title} description={pages.about.description} current="/about">
  <main id="main">
    <section class="page-head">
      <span class="kicker">מי אנחנו</span>
      <h1 class="h1">{site.name}<em aria-hidden="true">.</em></h1>
    </section>
    <section class="sect">
      <h2 class="h2">בקצרה</h2>
      <div class="prose">
        <p>{site.sentence}</p>
        <p>{site.line}.</p>
      </div>
    </section>
  </main>
</Site>
