---
import Frame from "../layouts/Frame.astro";
import { site } from "../data/site";
---

<Frame title={`מי אנחנו — ${site.name}`} current="about">
  <main class="reading reading-about">
    <h1>זה עלינו</h1>
    <p>{site.sentence}</p>
    <p>{site.line}</p>
    <a class="action" href="/join">הצטרפו לתנועה</a>
  </main>
</Frame>
