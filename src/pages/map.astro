---
import Base from "../layouts/Base.astro";
import "@xyflow/react/dist/style.css";
import "../map/styles.css";
import MapApp from "../map/App.tsx";
import { site } from "../data/site";
---

<Base title={`${site.mapTitle} — ${site.name}`} description="מפה של דתות ואיזמים כשושלות של דפוס מגדל בבל (קולקטיביזם) מול החירות.">
  <div class="map-root" id="content">
    <MapApp client:only="react" />
  </div>
</Base>
