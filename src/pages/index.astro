---
import Frame from "../layouts/Frame.astro";
import { pages, site } from "../data/site";
import { FRAMES, nodeOf } from "../map/chart";

const redGreen = FRAMES.find((frame) => frame.look === "redGreen");
if (!redGreen) {
  throw new Error("missing redGreen frame");
}
const redGreenNodes = redGreen.members
  .map((id) => nodeOf(id))
  .sort((a, b) => a.row - b.row);
---

<Frame title={pages.home.title} current="home">
  <a slot="bar" class="map-entry" href={site.mapHref}>
    <span class="side-liberty">{site.mapLiberty}</span>
    <span class="side-vs" dir="ltr">vs.</span>
    <span class="side-other">{site.mapOther}</span>
  </a>
  <main class="case" aria-label="הבית">
    <a class="sheet about-sheet" href="/about">
      <p class="about-title">זה<br />עלינו</p>
      <p class="about-body">{site.sentence}</p>
    </a>
    <a class="sheet join-sheet" href="/join">
      <h1 class="join-title">הצטרפו<br />לתנועה</h1>
      <p class="join-sub">קהילת הוואטסאפ</p>
    </a>
    <a class="sheet matter-sheet" href={site.mapHref} aria-label={site.mapTitle}>
      <p class="matter-title">
        {
          redGreen.label.split(/\s+/).map((word, i) => (
            <>
              {i > 0 && <br />}
              {word}
            </>
          ))
        }
      </p>
      <ul class="matter-list">
        {redGreenNodes.map((node) => <li>{node.short}</li>)}
      </ul>
    </a>
  </main>
</Frame>
