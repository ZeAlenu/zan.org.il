---
import JoinLine from "../components/JoinLine.astro";
import WingsIndex from "../components/WingsIndex.astro";
import { loadSite } from "../data/load";
import { pages, site } from "../data/site";
import Frame from "../layouts/Frame.astro";

const { menu } = await loadSite();
---

<Frame title={pages.home.title}>
  <main class="home">
    <section class="wall" id="wall" aria-label="הקיר">
      <a class="sheet about-sheet" href="/about">
        <h1 class="about-title">זה<br />עלינו</h1>
        <p class="about-body">{site.sentence}</p>
      </a>
    </section>
    <JoinLine />
    <WingsIndex groups={menu} />
    <footer class="home-footer">
      <a href={`mailto:${site.email}`} dir="ltr">{site.email}</a>
      <a href={site.x} rel="noopener" dir="ltr">{site.xHandle}</a>
      <a href={site.whatsapp} rel="noopener">{site.joinCall}</a>
    </footer>
  </main>
</Frame>
